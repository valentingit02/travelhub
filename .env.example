# Copiar como .env (NUNCA subir .env al repositorio)
DB_USER=travelhub
DB_PASSWORD=travelhub

# mock = todo simulado (recomendado para desarrollar)  |  real = usa Duffel y Hotelbeds
PROVEEDORES_MODO=mock
DUFFEL_TOKEN=
HOTELBEDS_HOTEL_API_KEY=
HOTELBEDS_HOTEL_SECRET=
HOTELBEDS_ACTIVITIES_API_KEY=
HOTELBEDS_ACTIVITIES_SECRET=

# ---------------- Mails ----------------
# Por defecto van a Mailpit (http://localhost:8025) y NO llegan a casillas reales.
# Para recibirlos en tu Gmail: activa la verificacion en dos pasos, crea una
# "contrasena de aplicacion" y descomenta estas lineas (usuario = tu Gmail completo).
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tucuenta@gmail.com
# MAIL_PASSWORD=la-contrasena-de-aplicacion-sin-espacios
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_REMITENTE=tucuenta@gmail.com

# Link que va en los mails (invitaciones de viaje compartido)
WEB_URL=http://localhost:8080

# Plazos de pago (para la demo podes bajar el compartido a 5m)
RESERVAS_VENCIMIENTO=15m
RESERVAS_VENCIMIENTO_COMPARTIDA=24h

# LLM local (solo si levantas el perfil llm)
OLLAMA_MODELO=llama3.2:1b
