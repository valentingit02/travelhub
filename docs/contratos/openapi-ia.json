    "/api/ia/kit": {
      "get": {
        "tags": [
          "Kit de viaje"
        ],
        "summary": "Kit De Viaje",
        "description": "Que llevar segun el clima, itinerario dia por dia y libros para el viaje (Open Library).",
        "operationId": "kit_de_viaje_api_ia_kit_get",
        "parameters": [
          {
            "name": "destino",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Destino"
            }
          },
          {
            "name": "desde",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Desde"
            }
          },
          {
            "name": "hasta",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Hasta"
            }
          },
          {
            "name": "pax",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 9,
              "minimum": 1,
              "default": 2,
              "title": "Pax"
            }
          },
          {
            "name": "preferencias",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Separadas por coma",
              "default": "",
              "title": "Preferencias"
            },
            "description": "Separadas por coma"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
