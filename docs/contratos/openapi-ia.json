  },
  "components": {
    "schemas": {
      "AsistenteRequest": {
        "properties": {
          "mensaje": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Mensaje",
            "examples": [
              "Quiero ir a la nieve en julio con mi novia"
            ]
          },
          "contexto": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contexto",
            "description": "La 'intencion' devuelta en la respuesta anterior"
          }
        },
        "type": "object",
        "required": [
          "mensaje"
        ],
        "title": "AsistenteRequest"
      },
      "EvaluarRequest": {
        "properties": {
          "tipoProducto": {
            "type": "string",
            "title": "Tipoproducto",
            "examples": [
              "AUTO"
            ]
          },
          "precio": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Precio",
            "examples": [
              1.0
            ]
          },
          "moneda": {
            "type": "string",
            "title": "Moneda",
            "default": "USD"
          },
          "destino": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destino",
            "examples": [
              "BRC"
            ]
          },
          "precioAnterior": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Precioanterior",
            "examples": [
              120.0
            ]
          },
          "productoRef": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Productoref"
          }
        },
        "type": "object",
        "required": [
          "tipoProducto",
          "precio"
        ],
        "title": "EvaluarRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Item": {
        "properties": {
          "tipo": {
            "type": "string",
            "title": "Tipo"
          },
          "descripcion": {
            "type": "string",
            "title": "Descripcion"
          },
          "precio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precio"
          }
        },
        "type": "object",
        "required": [
          "tipo",
          "descripcion"
        ],
        "title": "Item"
      },
      "ResumenRequest": {
        "properties": {
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "destino": {
            "type": "string",
            "title": "Destino"
          },
          "desde": {
            "type": "string",
            "format": "date",
            "title": "Desde"
          },
          "hasta": {
            "type": "string",
            "format": "date",
            "title": "Hasta"
          },
          "pasajeros": {
            "type": "integer",
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Pasajeros"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "number",
            "title": "Total"
          },
          "moneda": {
            "type": "string",
            "title": "Moneda"
          }
        },
        "type": "object",
        "required": [
          "nombre",
          "destino",
          "desde",
          "hasta",
          "pasajeros",
          "items",
          "total",
          "moneda"
        ],
        "title": "ResumenRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}